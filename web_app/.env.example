# Flask
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-64-char-hex-string

# Origin of the Next.js frontend, for CORS credentialed requests (session cookies)
FRONTEND_ORIGIN=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# TLS mode for managed Postgres (e.g. DigitalOcean). Leave blank locally.
DB_SSLMODE=

# Socket.IO / server
# Under gunicorn's eventlet worker in prod this must be "eventlet"; "threading"
# is the default for the plain dev server (python app.py).
SOCKETIO_ASYNC_MODE=threading
# Keep at 1 unless a Socket.IO message queue (e.g. Redis) is configured.
WEB_CONCURRENCY=1

# Google Cloud Storage
GCS_BUCKET_URL=https://storage.googleapis.com/your-bucket-name
# Bucket name (uploads) and, optionally, the service-account key JSON as a single
# env value. Reads (public URLs) work without a key; only uploads need it.
GCS_BUCKET_NAME=your-bucket-name
# GCS_SA_KEY_JSON=

# Speaking practice
# Download a Chinese Vosk model and point this to the extracted model folder.
# Default if unset: web_app/models/vosk-model-small-cn-0.22
VOSK_MODEL_PATH=
SPEAKING_SCORE_THRESHOLD=80
SPEAKING_MAX_AUDIO_BYTES=5242880
